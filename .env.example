# ============================================================
# Wahm Pay — انسخ هذا الملف إلى .env وعدّل القيم
# لا ترفع ملف .env أبداً إلى GitHub
# ============================================================

# مفتاح توقيع جلسات Flask (سلسلة عشوائية طويلة)
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# كلمة مرور لوحة التحكم
ADMIN_PASSWORD=change-me-strong-password

# المفتاح السري لحماية Webhook وواجهة API
# يُرسل في الترويسة: X-Secret-Key
SECRET_KEY=change-me-another-long-random-string

# مفتاح Google Gemini (من Google AI Studio)
GEMINI_API_KEY=

# إشعارات تيليجرام (اختياري لكن مستحسن)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# بيانات الحساب البنكي التي تظهر للعميل في صفحة الدفع
MERCHANT_IBAN=SAxxxxxxxxxxxxxxxxxxxxxxxx
MERCHANT_NAME=اسم التاجر

# الرابط العام للتطبيق بدون شرطة مائلة في النهاية
# مثال: https://wahm-pay.onrender.com
BASE_URL=https://your-app.onrender.com

# مدة صلاحية الفاتورة بالدقائق (الافتراضي 15)
INVOICE_VALIDITY_MINUTES=15

# مسار قاعدة SQLite (اختياري)
# على Render استخدم قرصاً ثابتاً: /var/data/payments.db
# DATABASE_PATH=/var/data/payments.db
